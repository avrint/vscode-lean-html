{
  "scopeName": "text.html.fragment",
  "fileTypes": [
    "fragment.html",
    "fragment.hml"
  ],
  "patterns": [
    {
      "include": "#handlebars"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "handlebars": {
      "patterns": [
        {
          "name": "meta.embedded.block.handlebars",
          "begin": "{{{?",
          "end": "}}}?",
          "patterns": [
            {
              "name": "keyword.control.handlebars",
              "match": "\\b(#each|#if|#unless|#with|else|/each|/if|/unless|/with)\\b"
            },
            {
              "name": "variable.other.object.property.handlebars",
              "match": "[a-zA-Z0-9_.-]+"
            }
          ]
        }
      ]
    }
  }
}